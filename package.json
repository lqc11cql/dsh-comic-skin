{
  "name": "dsh-comic-skin",
  "version": "1.0.2",
  "description": "Neo-brutalist comic sticker skin for DeepSeek Harness: ink outlines, hard offset shadows, halftone paper and sticker controls.",
  "type": "module",
  "license": "MIT",
  "author": "lqc11cql",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lqc11cql/dsh-comic-skin.git"
  },
  "homepage": "https://github.com/lqc11cql/dsh-comic-skin#readme",
  "bugs": {
    "url": "https://github.com/lqc11cql/dsh-comic-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "comic",
    "neo-brutalism",
    "sticker"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
